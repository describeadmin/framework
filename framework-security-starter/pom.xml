<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.describeadmin</groupId>
    <artifactId>framework-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>framework-security-starter</artifactId>

  <name>describeadmin :: framework-security-starter</name>
  <description>认证鉴权基座，并定义 AuthProvider 等 SPI 接口供扩展</description>

  <dependencies>
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-common</artifactId>
    </dependency>

    <!--
      登录失败次数限制需要一个可替换的缓存后端（内存 / Redis）。
      依赖的是契约模块，不是任何具体缓存中间件——framework-cache-starter 自身
      也不允许引入 Redis 之类的依赖。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-cache-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      认证/授权失败时要返回 Result JSON 而不是跳转登录页，需要序列化能力。
      只引 databind，不引 spring-boot-starter-web —— 本 starter 不应替业务方决定 Web 技术栈。
      版本由 spring-boot-dependencies 仲裁，保持 Jackson 2.x（CLAUDE.md 1）。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!--
      Servlet API 由内嵌容器（Undertow，见 framework-web-starter）在运行期提供，此处仅编译期需要，故 provided。
      写成 compile 会把一份 servlet-api 打进业务方的 fat jar，与容器自带的冲突。
    -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
