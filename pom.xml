<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    父 POM。

    注意：本项目【不继承】spring-boot-starter-parent。
    原因是本项目产出的是【库】而非【应用】，继承 spring-boot-starter-parent 会带来
    repackage 等面向应用的插件配置。改为在 framework-bom 中 import spring-boot-dependencies。
    详见 develop_plan.md 3.1。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>framework-parent</artifactId>
  <version>0.1.1</version>
  <packaging>pom</packaging>

  <name>describeadmin :: framework-parent</name>
  <description>AI 原生管理后台脚手架 —— 框架父 POM</description>
  <url>https://github.com/describeadmin/framework</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/framework.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/framework.git</developerConnection>
    <url>https://github.com/describeadmin/framework</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>framework-bom</module>
    <module>framework-common</module>
    <module>framework-web-starter</module>
    <module>framework-security-starter</module>
    <module>framework-mybatis-starter</module>
    <module>framework-system-starter</module>

    <!--
      业务方工程脚手架。放在最后：它不参与框架的依赖图，只是与框架同版本发布的一个模板产物。
      版本必须与框架一致 —— 它生成的 POM 里写的就是框架版本（develop_plan.md 9.2.2）。
    -->
    <module>describeadmin-archetype</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Java 版本策略（develop_plan.md 2.2.2）：
        构建用 JDK 21（由 toolchains 指定，与 PATH 无关）
        编译目标 release=17，使业务方 Java 17+ 即可使用
      不要把 release 改成 21 —— 那会把仍在 17 上的使用方挡在门外。
    -->
    <java.build.version>21</java.build.version>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- 上游版本，事实来源见 VERSION_BASELINE.md -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <lombok.version>1.18.46</lombok.version>

    <!--
      5.7-safe 默认值（develop_plan.md 2.3.3）。
      ⚠️ Connector/J 自 8.3.0 起官方不再支持 MySQL 5.7，8.2.0 是最后一个支持的版本。
      不要"顺手升级"。业务方可在自己的 pom 中覆盖。
    -->
    <mysql-connector.version>8.2.0</mysql-connector.version>

    <!-- 构建插件版本（均为核验过的稳定版，不使用 beta / milestone） -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-toolchains-plugin.version>3.3.0</maven-toolchains-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>

      <!--
        ==========================================================================
        ⚠️ 顺序敏感区：本条目必须排在 spring-boot-dependencies 的 import 之前
        ==========================================================================

        Maven 的 dependencyManagement 采用【先声明者胜】；并且 import 一个 BOM 只会引入它的
        dependencyManagement 条目，【不会】继承它的 <properties> —— 也就是说无法通过覆盖
        ${mysql.version} 来改变 spring-boot-dependencies 管理的驱动版本（那里已解析为字面量 9.7.0）。
        唯一可行的方式就是在 import 之前显式声明。

        Spring Boot 3.5.16 默认管理 mysql-connector-j:9.7.0，而 Connector/J 自 8.3.0 起
        官方不再支持 MySQL 5.7（"8.0 and later"）。此处压回 8.2.0 —— 最后一个支持 5.7 的版本。
        见 develop_plan.md 2.3.3 与 VERSION_BASELINE.md 冲突 A。

        业务方使用 MySQL 8.0+ 或国产化数据库时，在自己的 pom.xml 中先声明对应版本即可覆盖。
      -->
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql-connector.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-bom</artifactId>
        <version>${mybatis-plus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        框架自身模块。声明在此处而非 framework-bom 中，有两个原因：
          1. 各 starter 模块互相引用（如 web-starter 依赖 common）时需要在此拿到版本，
             它们继承的是本 POM，不是 framework-bom
          2. framework-bom 继承本 POM，其【有效 POM】会包含这些条目，
             因此业务方 import framework-bom 时同样能拿到 —— 无需重复声明，避免版本漂移
      -->
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-web-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-security-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-mybatis-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-system-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

    </dependencies>
  </dependencyManagement>

  <!--
    注意：这里【不能】import framework-bom。
    framework-bom 的 parent 是本 POM，若本 POM 再 import framework-bom 会形成
    import 环（Maven 会直接报 "form a cycle" 并中止构建）。
    framework-bom 通过继承拿到上面这些管理条目，自己只追加框架各模块。
  -->

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        Toolchains：显式声明构建所需的 JDK，Maven 自行从 ~/.m2/toolchains.xml 中查找。
        这样构建结果与 PATH 上是哪个 java 无关（develop_plan.md 2.2.2）。
        首次配置见 scripts/toolchains.xml.sample。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>${maven-toolchains-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>select-jdk-toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <version>${java.build.version}</version>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>

      <!--
        Enforcer：把方案里的约束变成构建期强制，而不是靠代码评审留意。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <!--
                  框架的任何模块都不得引入 JDBC 驱动（develop_plan.md 2.3.2 / CLAUDE.md 3.4）。
                  驱动由业务方声明；此处从构建期堵死，防止有人"顺手"加进来。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.mysql:mysql-connector-j</exclude>
                    <exclude>mysql:mysql-connector-java</exclude>
                    <exclude>org.mariadb.jdbc:mariadb-java-client</exclude>
                    <exclude>com.oceanbase:oceanbase-client</exclude>
                    <exclude>com.dameng:*</exclude>
                    <exclude>cn.com.kingbase:*</exclude>
                  </excludes>
                  <message>
                    框架模块不得依赖任何 JDBC 驱动。驱动由业务方在自己的 pom.xml 中声明。
                    见 develop_plan.md 2.3.2 与 CLAUDE.md 3.4。
                  </message>
                </bannedDependencies>
                <!--
                  Jackson 3 的坐标是 tools.jackson.*，包名与 2.x 不兼容。
                  本项目锁定 Jackson 2.x（develop_plan.md 2.2.1）。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    本项目锁定 Jackson 2.x（com.fasterxml.jackson.*）。
                    tools.jackson.* 是 Jackson 3，属于 Spring Boot 4.x 生态。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      发布 profile。需要：
        1. Central Portal User Token  → settings.xml 的 <server id="central">
        2. GPG 密钥                    → gpg.keyname / 或默认密钥
      本地日常构建不激活此 profile。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- CI 环境下从环境变量读 passphrase，避免交互式提示 -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 先上传为 draft，人工在 Portal 上确认后再 release；稳定后可改为 automatic -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
