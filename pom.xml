<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    父 POM。

    注意：本项目【不继承】spring-boot-starter-parent。
    原因是本项目产出的是【库】而非【应用】，继承 spring-boot-starter-parent 会带来
    repackage 等面向应用的插件配置。改为在 framework-bom 中 import spring-boot-dependencies。
    详见 develop_plan.md 3.1。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>framework-parent</artifactId>
  <version>0.2.2</version>
  <packaging>pom</packaging>

  <name>describeadmin :: framework-parent</name>
  <description>AI 原生管理后台脚手架 —— 框架父 POM</description>
  <url>https://github.com/describeadmin/framework</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/framework.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/framework.git</developerConnection>
    <url>https://github.com/describeadmin/framework</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>framework-bom</module>
    <module>framework-common</module>
    <module>framework-web-starter</module>
    <module>framework-security-starter</module>
    <module>framework-mybatis-starter</module>
    <module>framework-cache-starter</module>
    <module>framework-system-starter</module>
    <module>framework-storage-starter</module>
    <module>framework-notify-starter</module>

    <!--
      这里【只有核心模块】。可选插件（framework-cache-redis-starter 等）一律独立成仓，
      清单见 docs 仓的 registry.md 与 repos.yml。

      插件不在本 reactor 里，是为了斩断两条耦合：
        - 版本线：框架发 0.3.0 时，一行没改的插件不必跟着发；插件修 bug 也不必等框架的发布窗口
        - 发布：mvn deploy 不会把插件一起推上 Central
      还有一个副作用是刻意要的 —— 插件只能以 import framework-bom 的方式消费框架，
      也就是业务方的姿势，于是业务方会遇到的问题会先在插件仓暴露。
    -->

    <!--
      业务方工程脚手架。放在最后：它不参与框架的依赖图，只是与框架同版本发布的一个模板产物。
      版本必须与框架一致 —— 它生成的 POM 里写的就是框架版本（develop_plan.md 9.2.2）。
    -->
    <module>describeadmin-archetype</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Java 版本策略（develop_plan.md 2.2.2）：
        构建 JDK 只要求 17 或更高，用哪个由构建者自己定（enforcer 的 requireJavaVersion 兜底）
        编译目标 release=17，使业务方 Java 17+ 即可使用
      不要把 release 改成 21 —— 那会把仍在 17 上的使用方挡在门外。

      不再用 maven-toolchains-plugin 钉死构建 JDK：release=17 本身已保证产物在 Java 17 上可运行，
      再钉一个具体版本只会让没配 ~/.m2/toolchains.xml 的协作者/AI 以
      "Cannot find matching toolchain" 直接构建失败，比它要防的坑更劝退（VERSION_BASELINE 第八轮）。
    -->
    <maven.compiler.release>17</maven.compiler.release>

    <!-- 上游版本，事实来源见 VERSION_BASELINE.md -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>

    <!--
      5.7-safe 默认值（develop_plan.md 2.3.3）。
      ⚠️ Connector/J 自 8.3.0 起官方不再支持 MySQL 5.7，8.2.0 是最后一个支持的版本。
      不要"顺手升级"。业务方可在自己的 pom 中覆盖。
    -->
    <mysql-connector.version>8.2.0</mysql-connector.version>

    <!-- 构建插件版本（均为核验过的稳定版，不使用 beta / milestone） -->
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>

      <!--
        ==========================================================================
        ⚠️ 顺序敏感区：本条目必须排在 spring-boot-dependencies 的 import 之前
        ==========================================================================

        Maven 的 dependencyManagement 采用【先声明者胜】；并且 import 一个 BOM 只会引入它的
        dependencyManagement 条目，【不会】继承它的 <properties> —— 也就是说无法通过覆盖
        ${mysql.version} 来改变 spring-boot-dependencies 管理的驱动版本（那里已解析为字面量 9.7.0）。
        唯一可行的方式就是在 import 之前显式声明。

        Spring Boot 3.5.16 默认管理 mysql-connector-j:9.7.0，而 Connector/J 自 8.3.0 起
        官方不再支持 MySQL 5.7（"8.0 and later"）。此处压回 8.2.0 —— 最后一个支持 5.7 的版本。
        见 develop_plan.md 2.3.3 与 VERSION_BASELINE.md 冲突 A。

        业务方使用 MySQL 8.0+ 或国产化数据库时，在自己的 pom.xml 中先声明对应版本即可覆盖。
      -->
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql-connector.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-bom</artifactId>
        <version>${mybatis-plus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        框架自身模块。声明在此处而非 framework-bom 中，有两个原因：
          1. 各 starter 模块互相引用（如 web-starter 依赖 common）时需要在此拿到版本，
             它们继承的是本 POM，不是 framework-bom
          2. framework-bom 继承本 POM，其【有效 POM】会包含这些条目，
             因此业务方 import framework-bom 时同样能拿到 —— 无需重复声明，避免版本漂移
      -->
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-web-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-security-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-mybatis-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-cache-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-system-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-storage-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-notify-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        ⚠️ 独立成仓的插件【不在此处登记】。

        写在这里会让 framework-bom 用 ${project.version} 去仲裁插件版本，
        而插件已经有了自己的版本线 —— 业务方引一个不写版本号的插件时，
        拿到的会是一个与框架同号、但根本不存在的制品，报错只说"找不到"，
        不会有任何东西指向这里。插件版本由业务方自己写。
      -->

    </dependencies>
  </dependencyManagement>

  <!--
    注意：这里【不能】import framework-bom。
    framework-bom 的 parent 是本 POM，若本 POM 再 import framework-bom 会形成
    import 环（Maven 会直接报 "form a cycle" 并中止构建）。
    framework-bom 通过继承拿到上面这些管理条目，自己只追加框架各模块。
  -->

  <dependencies>
    <!--
      框架源码【不引 lombok】——一律手写访问器 / 构造函数 / Logger（@Slf4j 也不用）。
      注解处理器绑 javac 内部 API，是"换新 JDK 可能编不过"的变量，与"任意 JDK ≥ 17
      都能直接构建框架本身"的承诺冲突，所以不进这条编译链，也不配 annotationProcessorPaths。

      注意这【不】等于框架反对 lombok：codegen 生成的业务代码用 @Getter / @Setter /
      @RequiredArgsConstructor 去掉逐字段样板，那份 lombok 依赖由 archetype 生成的业务
      pom 自带、版本走 spring-boot-dependencies，编译发生在业务方的构建链上、JDK 由业务方
      掌控。framework-bom 不仲裁 lombok。详见 CLAUDE.md 4.1 与 develop_plan.md 3.3。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!--
            测试 JVM 必须显式指定 UTF-8。默认取平台编码，中文 Windows 上是 GBK，
            断言里的中文会与被测代码里的中文对不上，而失败信息本身也是乱码，
            排查方向会完全跑偏。见 CLAUDE.md 3.6 与 VERSION_BASELINE.md 发现 ④⑤。
            sample-app 早已配了这一行，框架侧因为此前没有任何测试而一直空缺。
          -->
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <!--
        Enforcer：把方案里的约束变成构建期强制，而不是靠代码评审留意。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <!--
                  构建 JDK 只要求 17+。release=17 已保证产物在 Java 17 上可运行，
                  构建者用 17 / 21 / 更高都行；不再用 maven-toolchains-plugin 钉死具体版本
                  （develop_plan.md 2.2.2，VERSION_BASELINE 第八轮）。
                -->
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
                <!--
                  框架的任何模块都不得引入 JDBC 驱动（develop_plan.md 2.3.2 / CLAUDE.md 3.4）。
                  驱动由业务方声明；此处从构建期堵死，防止有人"顺手"加进来。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.mysql:mysql-connector-j</exclude>
                    <exclude>mysql:mysql-connector-java</exclude>
                    <exclude>org.mariadb.jdbc:mariadb-java-client</exclude>
                    <exclude>com.oceanbase:oceanbase-client</exclude>
                    <exclude>com.dameng:*</exclude>
                    <exclude>cn.com.kingbase:*</exclude>
                  </excludes>
                  <message>
                    框架模块不得依赖任何 JDBC 驱动。驱动由业务方在自己的 pom.xml 中声明。
                    见 develop_plan.md 2.3.2 与 CLAUDE.md 3.4。
                  </message>
                </bannedDependencies>
                <!--
                  Jackson 3 的坐标是 tools.jackson.*，包名与 2.x 不兼容。
                  本项目锁定 Jackson 2.x（develop_plan.md 2.2.1）。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    本项目锁定 Jackson 2.x（com.fasterxml.jackson.*）。
                    tools.jackson.* 是 Jackson 3，属于 Spring Boot 4.x 生态。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>

          <!--
            单独成一个 execution 而不与上面两条合并：本条只适用于核心。
            插件已独立成仓、不继承本 POM，因此天然不受这条约束 ——
            但它们仍要自带上面那两条（JDBC 驱动、Jackson 3），见 registry.md 准入规范。
          -->
          <execution>
            <id>enforce-core-thin</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!--
                  「核心薄、能力可插拔」的构建期门禁。

                  核心模块只允许依赖 Spring Boot 自家 starter、MyBatis-Plus 与框架自身模块。
                  下面这些是典型的"重实现"：它们各自都应当以独立 starter 的形态按需引入
                  （如 Redis 缓存 → framework-cache-redis-starter），而不是压进核心，
                  让所有业务方——包括根本用不到的那些——都背上这份依赖。

                  这条规则不能只写在规范里：依赖是"顺手加一行"就能引入的，
                  而它一旦进了已发布的核心制品，再想摘出去就是破坏性变更。
                  插件模块自身需要这些依赖，在各自 pom 里覆盖本规则即可。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework.boot:spring-boot-starter-data-redis</exclude>
                    <exclude>redis.clients:jedis</exclude>
                    <exclude>org.apache.poi:*</exclude>
                    <exclude>com.alibaba:easyexcel</exclude>
                    <exclude>org.springdoc:*</exclude>
                    <exclude>com.github.xiaoymin:*</exclude>
                    <exclude>org.quartz-scheduler:*</exclude>
                    <exclude>com.squareup.okhttp3:*</exclude>
                    <exclude>org.apache.httpcomponents.client5:*</exclude>
                    <!-- 对象存储 SDK：具体实现应做成 framework-storage-<厂商>-starter 插件 -->
                    <exclude>com.aliyun.oss:*</exclude>
                    <exclude>com.aliyun:aliyun-java-sdk-*</exclude>
                    <exclude>com.qcloud:cos_api</exclude>
                    <exclude>com.amazonaws:aws-java-sdk-s3</exclude>
                    <exclude>software.amazon.awssdk:s3</exclude>
                    <exclude>io.minio:minio</exclude>
                    <!-- 厂商推送/消息 SDK：具体实现应做成 framework-notify-<厂商>-starter 插件 -->
                    <exclude>com.aliyun:dingtalk</exclude>
                    <exclude>com.dingtalk.open:*</exclude>
                    <exclude>com.github.binarywang:weixin-java-cp</exclude>
                    <exclude>com.aliyun:dysmsapi*</exclude>
                    <exclude>com.twilio.sdk:twilio</exclude>
                  </excludes>
                  <message>
                    核心模块不得引入重量级第三方依赖。这类能力应做成独立的
                    framework-&lt;能力&gt;-starter 由业务方按需引入。见 CLAUDE.md 第 4 节。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      发布 profile。需要：
        1. Central Portal User Token  → settings.xml 的 <server id="central">
        2. GPG 密钥                    → gpg.keyname / 或默认密钥
      本地日常构建不激活此 profile。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- CI 环境下从环境变量读 passphrase，避免交互式提示 -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 先上传为 draft，人工在 Portal 上确认后再 release；稳定后可改为 automatic -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
