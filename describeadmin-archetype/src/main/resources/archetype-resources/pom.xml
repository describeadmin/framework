<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    由 describeadmin-archetype 生成。

    父 POM 是 spring-boot-starter-parent，【不是】框架的 framework-parent ——
    业务方工程与框架是依赖关系，不是继承关系。
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>

  <name>${artifactId}</name>

  <properties>
    <!--
      产物必须能跑在 Java 17 上（等价于 maven.compiler.release=17）。

      这一行约束的是【产物】，不是【你用哪个 JDK 构建】——
      你用 17 / 21 / 25 构建都可以，编译器一律按 Java 17 的 API 与字节码产出。
      唯一的硬要求是 Maven 进程自身跑在 JDK 17+（spring-boot-maven-plugin:repackage 的要求），
      用 `mvn -v` 看 Java version 确认，不要用 `java -version`。
    -->
    <java.version>17</java.version>

    <describeadmin.version>${describeadminVersion}</describeadmin.version>

    <!--
      ⚠️ 这一行【不能删】，删了会连不上 MySQL 5.7。

      原因反直觉：Maven 中【继承】来的 dependencyManagement 优先级高于【import】进来的 BOM。
      framework-bom 给的 5.7-safe 默认值 8.2.0 会被 spring-boot-starter-parent 管理的
      新版驱动盖掉，而 Connector/J 自 8.3.0 起官方不再支持 MySQL 5.7。
      在这里显式覆盖 spring-boot-dependencies 的 mysql.version 属性是唯一可行的方式。

      目标库是 MySQL 8.0+ 或国产化数据库时，改这里的版本或换成对应驱动坐标即可。
    -->
    <mysql.version>8.2.0</mysql.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-bom</artifactId>
        <version>${describeadmin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 框架模块一律【不写版本号】，版本由 framework-bom 统一仲裁 -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-web-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-security-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-mybatis-starter</artifactId>
    </dependency>

    <!--
      系统管理：用户 / 角色 / 菜单 / 部门 + 登录接口，以及它们的建表与种子 SQL
      （schema-rbac.sql / seed-rbac.sql 都在这个 jar 里，你的工程不需要自己带）。
      引这一个依赖就得到完整 RBAC，框架修了 bug 升个版本就拿到。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-system-starter</artifactId>
    </dependency>

    <!--
      JDBC 驱动由业务方声明，框架不提供（框架的 enforcer 从构建期堵死了这件事）。
      版本不写在这里 —— 由上面的 mysql.version 属性决定。
    -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      codegen 生成的 Entity / Controller 用 @Getter / @Setter / @RequiredArgsConstructor，
      少写逐字段的机械样板。版本【不写】—— 由 spring-boot-dependencies 仲裁；
      <optional>true</optional> 保证它不会传递到依赖本工程的下游。
      注解处理器由 javac 从 classpath 上的 SPI 描述符自动发现，不需要额外配
      maven-compiler-plugin 的 annotationProcessorPaths。
      框架自身源码不用 lombok，这条只服务于生成物。
    -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            强制 UTF-8。断言里出现中文时，平台默认编码（中文 Windows 是 GBK）
            会让「值明明对、断言就是不过」这种没法排查的失败出现。
          -->
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
