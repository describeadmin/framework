<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.describeadmin</groupId>
    <artifactId>framework-parent</artifactId>
    <version>0.2.2</version>
  </parent>

  <artifactId>framework-common</artifactId>

  <name>describeadmin :: framework-common</name>
  <description>通用工具类、常量、枚举、Result 包装类</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!--
        只过滤这一个文件，不是整个 resources 目录。
        对全目录开过滤会在将来放进任何二进制资源（图标、字体、模板）时把它们改坏，
        而那种损坏是静默的——文件还在、大小差不多，打开才发现坏了。
      -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/describeadmin-framework.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>META-INF/describeadmin-framework.properties</exclude>
        </excludes>
      </resource>
    </resources>
  </build>

</project>
